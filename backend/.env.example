DATABASE_URL=postgresql+asyncpg://elderly:elderly@localhost:5433/elderly
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=480
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_RECONNECT_DELAY=2.0
MQTT_MAX_RECONNECT_DELAY=30.0
MQTT_TOPIC_PREFIX=elderly
MQTT_QOS=1
# Groq AI Enrichment Engine
GROQ_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_TOKENS=500
GROQ_TEMPERATURE=0.1

# NVIDIA AI Enrichment Engine (legacy fallback)
NVIDIA_ENABLED=false
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_TIMEOUT_SECONDS=6.0
NVIDIA_MAX_TOKENS=500
NVIDIA_TEMPERATURE=0.1
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_S=15
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Sensor Health & Processing Thresholds
SENSOR_MAX30102_ABSENCE_THRESHOLD_S=60.0
SENSOR_DHT11_MIN_INTERVAL_S=2.0
SENSOR_DHT11_FROZEN_DURATION_S=300.0
SENSOR_MPU6050_FLATLINE_SAMPLES=5
SENSOR_GPS_NO_FIX_DURATION_S=180.0
DEVICE_OFFLINE_THRESHOLD_S=60.0
BATTERY_WARNING_THRESHOLD=20.0
BATTERY_CRITICAL_THRESHOLD=10.0
