DATABASE_URL=postgresql+asyncpg://elderly:elderly@localhost:5433/elderly
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=480
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_RECONNECT_DELAY=2.0
MQTT_MAX_RECONNECT_DELAY=30.0
MQTT_TOPIC_PREFIX=elderly
MQTT_QOS=1
# NVIDIA AI Enrichment Engine
NVIDIA_ENABLED=true
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_TIMEOUT_SECONDS=6.0
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.2
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct
AI_TIMEOUT_S=6
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Sensor Health & Processing Thresholds
SENSOR_MAX30102_ABSENCE_THRESHOLD_S=60.0
SENSOR_DHT11_MIN_INTERVAL_S=2.0
SENSOR_DHT11_FROZEN_DURATION_S=300.0
SENSOR_MPU6050_FLATLINE_SAMPLES=5
SENSOR_GPS_NO_FIX_DURATION_S=180.0
DEVICE_OFFLINE_THRESHOLD_S=60.0
BATTERY_WARNING_THRESHOLD=20.0
BATTERY_CRITICAL_THRESHOLD=10.0
